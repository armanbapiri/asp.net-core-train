@using WebApplication5.Entity
@model List<Book>

@{
    ViewData["Title"] = "Home Page";
}
<div class="row" dir="rtl">
    <div class="col-12">

        <table class="table text-end">
            <thead>
                <tr>
                    <th>شناسه</th>
                    <th>عنوان کتاب</th>
                    <th>تعداد صفحات</th>
                    <th>نویسنده</th>
                    <th>دسته بندی</th>
                </tr>

            </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Title</td>
                        <td>@item.PageCount</td>
                        <td>@item.AutherName</td>
                        <td>
                            @foreach (var category in item.Categories)
                            {
                                <span>@category.CategoryBookId - @category.BookCategory.Title</span>                     
                                
                            }
                        </td>
                    </tr>

                }
            </tbody>

        </table>
    </div>
</div>
